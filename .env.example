# AI Collision Anticipation System - Environment Variables
# Copy this file to .env and fill in values

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# YOLO model path (actual file in project root: yolo11n.pt)
YOLO_MODEL_PATH=yolo11n.pt

# Detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.45

# Backend API port (uvicorn api.main:app --port 8000)
API_PORT=8000

# Frontend dev server port (cd frontend && npm run dev)
FRONTEND_PORT=5173

# Legacy Streamlit dashboard port (no longer part of the active app)
# DASHBOARD_PORT=8501

# --- AI Voice Safety Assistant (Part 4) ---
# Master switch for the whole voice layer.
# VOICE_ASSISTANT_ENABLED=true
# Backend voice provider: log (default) or edge_tts (requires: pip install edge-tts)
# VOICE_PROVIDER=log
# Audio volume used by browser playback (0.0 - 1.0).
# VOICE_VOLUME=1.0
# Language tag for spoken phrases (default: Telugu). Supported: en-IN, hi-IN,
# te-IN, ta-IN, kn-IN, ml-IN, mr-IN, gu-IN, bn-IN, pa-IN, or-IN, ur-IN.
# VOICE_LANGUAGE=te-IN
# Optional voice preference for TTS providers (edge-tts uses e.g. en-US-ChristopherNeural).
# VOICE_VOICE=
# Lowest risk level that produces speech: SAFE, LOW, MEDIUM, HIGH or CRITICAL.
# VOICE_MIN_ALERT_LEVEL=MEDIUM
# Repetition cooldowns per level, in seconds.
# VOICE_COOLDOWN_SAFE_S=20
# VOICE_COOLDOWN_MEDIUM_S=10
# VOICE_COOLDOWN_HIGH_S=5
# VOICE_COOLDOWN_CRITICAL_S=1.5
# A threat level must persist this many frames before being announced (debounce).
# RISK_STABILITY_WINDOW_FRAMES=5
# Maximum voice events kept per job queue (oldest dropped first).
# VOICE_MAX_QUEUE=8
# TTC is spoken only when it is at or below this cap (seconds).
# VOICE_TTC_MAX_S=10
# --- Speed validation (same-track speed is spoken only when it passes ALL below) ---
# Minimum ESTIMATED-speed confidence to speak the speed.
# VOICE_SPEED_MIN_CONFIDENCE=0.7
# Maximum reasonable km/h; larger values are treated as outliers (not spoken).
# VOICE_MAX_REASONABLE_SPEED_KMH=180
# Maximum age (seconds) of the speed measurement (source time) before it is stale.
# VOICE_MAX_SPEED_DATA_AGE_S=1.0
# A speed change this large (km/h) re-announces the SAME risk level (still cooldown-gated).
# VOICE_SPEED_CHANGE_ALERT_THRESHOLD_KMH=10
# Text used by the "Test voice" button (English; per-language test strings are
# defined in src/voice/languages.py).
# VOICE_TEST_TEXT=Voice assistant test.
# Conversational mode: backend answers natural-language questions.
# ENABLE_CONVERSATIONAL_MODE=true
# Browser Web Speech API playback for voice_alert events.
# ENABLE_BROWSER_FALLBACK=true

# --- Deployment: Vercel frontend + separate persistent backend ---
# Comma-separated exact origins the backend may answer from. Never use '*' in
# production. Leave empty to keep the default local dev origins.
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
# Backend host for a separate deployment (Render/Railway/Fly/VPS).
# --- Frontend build-time variables (set in the Vercel project env) ---
# VITE_API_URL=https://your-backend-host.example
# VITE_WS_URL=wss://your-backend-host.example
