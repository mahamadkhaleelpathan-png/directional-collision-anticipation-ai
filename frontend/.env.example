# Frontend build-time environment (React + Vite).
# Copy this file to frontend/.env OR set these in the Vercel project env.
# Leave both empty locally to use the Vite dev proxy (backend on :8000).

# Production backend REST API base (no trailing slash), e.g.:
# VITE_API_URL=https://your-backend-host.example

# Production backend WebSocket base (wss), e.g.:
# VITE_WS_URL=wss://your-backend-host.example